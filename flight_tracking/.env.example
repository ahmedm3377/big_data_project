# OpenSky API settings
# Newer OpenSky API access may require an account/token for /api/states/all.
OPENSKY_API_URL=https://opensky-network.org/api/states/all
OPENSKY_BEARER_TOKEN=

# Producer settings
POLL_INTERVAL_SECONDS=15
MAX_RECORDS_PER_POLL=500

# Kafka settings
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_TOPIC=aircraft_states_raw

# Spark/Hive settings
SPARK_APP_NAME=FlightTrackingStreaming
HIVE_DATABASE=flight_tracking
CHECKPOINT_BASE_DIR=flight_tracking/checkpoints

